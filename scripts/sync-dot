#!/bin/bash

# Configuration
DOTFILES_DIR="$HOME/dotfiles"
CONFIG_DIR="$HOME/.config"
DOTFILES_CONFIG="$DOTFILES_DIR/.config"
SCRIPTS_DIR="$DOTFILES_DIR/scripts"
LOCAL_BIN="$HOME/.local/bin"

# Files/dirs to ignore when syncing root dotfiles
IGNORE_LIST=(".git" ".gitignore" "README.md" "scripts" ".config" ".taskrc" ".yamlfmt" ".yamllint.yml")

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

usage() {
    echo "Usage: $(basename "$0") [options] <n> [name2 ...]"
    echo ""
    echo "Manage dotfiles and scripts."
    echo ""
    echo "Examples:"
    echo "  $(basename "$0") -c nvim          # Add ~/.config/nvim to dotfiles"
    echo "  $(basename "$0") -s myscript      # Add ~/.local/bin/myscript to dotfiles"
    echo "  $(basename "$0") -d .vimrc        # Add ~/.vimrc to dotfiles"
    echo "  $(basename "$0") --sync           # Sync all (creates symlinks)"
    echo ""
    echo "Options:"
    echo "  -c, --config <names>  Add item(s) from ~/.config to dotfiles/.config"
    echo "  -s, --script <names>  Add script(s) from ~/.local/bin to dotfiles/scripts"
    echo "  -d, --dot <names>     Add dotfile(s) from ~/ to dotfiles/"
    echo "  -l, --list            List untracked items in all locations"
    echo "  --sync                Sync all: create symlinks for everything"
    echo "  -h, --help            Show this help message"
}

# Check if item is in ignore list
is_ignored() {
    local name="$1"
    for ignored in "${IGNORE_LIST[@]}"; do
        [[ "$name" == "$ignored" ]] && return 0
    done
    return 1
}

# List untracked items in a directory
list_untracked() {
    local dir="$1"
    local label="$2"
    local pattern="${3:-*}"  # default to all files
    
    echo "$label:"
    local found=0
    for item in "$dir"/$pattern; do
        [[ -e "$item" ]] || continue
        [[ -L "$item" ]] && continue
        
        name=$(basename "$item")
        is_ignored "$name" && continue
        
        if [[ -d "$item" ]]; then
            echo "  $name/"
        else
            echo "  $name"
        fi
        ((found++))
    done
    if [[ $found -eq 0 ]]; then
        echo "  (none)"
    fi
    echo ""
}

# Generic function to add item to dotfiles
add_item() {
    local source="$1"
    local dest="$2"
    local dest_dir=$(dirname "$dest")
    local name=$(basename "$source")

    # Check if source exists
    if [[ ! -e "$source" ]]; then
        echo -e "${RED}Error:${NC} $source does not exist"
        return 1
    fi

    # Check if it's already a symlink
    if [[ -L "$source" ]]; then
        echo -e "${YELLOW}Skipping:${NC} $source is already a symlink"
        return 0
    fi

    # Check if destination already exists (including broken symlinks)
    if [[ -e "$dest" || -L "$dest" ]]; then
        echo -e "${RED}Error:${NC} $dest already exists in dotfiles"
        return 1
    fi

    # Create destination directory if needed
    mkdir -p "$dest_dir"

    # Move and link
    echo "Moving $source -> $dest"
    mv "$source" "$dest"
    
    echo "Creating symlink $source -> $dest"
    ln -s "$dest" "$source"

    # Verify
    if [[ -L "$source" && -e "$source" ]]; then
        echo -e "${GREEN}Success:${NC} $name added to dotfiles"
    else
        echo -e "${RED}Error:${NC} Something went wrong with $name"
        return 1
    fi
}

# Sync symlinks from dotfiles to target directory
sync_dir() {
    local source_dir="$1"
    local target_dir="$2"
    local label="$3"
    local pattern="${4:-*}"

    if [[ ! -d "$source_dir" ]]; then
        echo -e "${YELLOW}Skipping $label:${NC} $source_dir does not exist"
        echo ""
        return 0
    fi

    mkdir -p "$target_dir"

    echo "Syncing $label..."
    local count=0
    local skipped=0

    for item in "$source_dir"/$pattern; do
        [[ -e "$item" || -L "$item" ]] || continue
        name=$(basename "$item")
        
        # Skip ignored items
        if is_ignored "$name"; then
            continue
        fi

        # Skip if source is a symlink (should be real files in dotfiles)
        if [[ -L "$item" ]]; then
            echo -e "  ${RED}Warning:${NC} $name is a symlink in dotfiles repo, skipping"
            continue
        fi
        
        target="$target_dir/$name"

        # Skip if already correctly linked
        if [[ -L "$target" && "$(readlink "$target")" == "$item" ]]; then
            ((skipped++))
            continue
        fi

        # If target exists and is NOT a symlink, don't touch it
        if [[ -e "$target" && ! -L "$target" ]]; then
            echo -e "  ${YELLOW}Skipping:${NC} $name (local file exists, use -f to overwrite)"
            continue
        fi

        # Only remove if it's a symlink (broken or pointing elsewhere)
        if [[ -L "$target" ]]; then
            echo -e "  ${YELLOW}Replacing symlink:${NC} $name"
            rm "$target"
        fi

        ln -s "$item" "$target"
        echo -e "  ${GREEN}Linked:${NC} $name"
        ((count++))
    done

    echo "  Done: $count new, $skipped already linked"
    echo ""
}

sync_all() {
    echo ""
    sync_dir "$DOTFILES_CONFIG" "$CONFIG_DIR" "configs"
    sync_dir "$SCRIPTS_DIR" "$LOCAL_BIN" "scripts"
    sync_dir "$DOTFILES_DIR" "$HOME" "dotfiles" ".*"

    # PATH reminder
    if [[ ":$PATH:" != *":$LOCAL_BIN:"* ]]; then
        echo -e "${YELLOW}Note:${NC} $LOCAL_BIN is not in your PATH"
        echo "Add to your shell config:"
        echo "  export PATH=\"\$HOME/.local/bin:\$PATH\""
    fi
}

# Parse arguments
if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
    -l|--list)
        echo ""
        list_untracked "$CONFIG_DIR" "Untracked in ~/.config"
        list_untracked "$LOCAL_BIN" "Untracked in ~/.local/bin"
        list_untracked "$HOME" "Untracked dotfiles in ~/" ".*"
        exit 0
        ;;
    --sync)
        sync_all
        exit 0
        ;;
    -c|--config)
        shift
        if [[ $# -eq 0 ]]; then
            echo "Error: -c requires at least one name"
            exit 1
        fi
        for name in "$@"; do
            add_item "$CONFIG_DIR/$name" "$DOTFILES_CONFIG/$name"
            echo ""
        done
        exit 0
        ;;
    -s|--script)
        shift
        if [[ $# -eq 0 ]]; then
            echo "Error: -s requires at least one name"
            exit 1
        fi
        for name in "$@"; do
            add_item "$LOCAL_BIN/$name" "$SCRIPTS_DIR/$name"
            echo ""
        done
        exit 0
        ;;
    -d|--dot)
        shift
        if [[ $# -eq 0 ]]; then
            echo "Error: -d requires at least one name"
            exit 1
        fi
        for name in "$@"; do
            add_item "$HOME/$name" "$DOTFILES_DIR/$name"
            echo ""
        done
        exit 0
        ;;
    -*)
        echo "Unknown option: $1"
        usage
        exit 1
        ;;
    *)
        echo "Error: specify -c (config), -s (script), or -d (dotfile)"
        usage
        exit 1
        ;;
esac
